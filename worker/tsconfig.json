{
  // Worker 側の型チェック。画面側 (../tsconfig.json の DOM) と型が混ざらないよう分ける。
  // Env の型は Cloudflare の Vite プラグインか `cf workers types` が .cloudflare/types に書く。
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022"], "strict": true, "noEmit": true,
    "skipLibCheck": true, "isolatedModules": true, "noUnusedLocals": true,
    "types": []
  },
  "include": [".", "../.cloudflare/types"]
}
