# 灯 Tomoshibi の環境変数の一覧。値は入れない。実際の値は下の git 管理外のファイルに置く。
# Vite が画面側に渡すのは VITE_ で始まる変数だけ。それ以外はブラウザに出ない。
#
# ファイルの使い分け (Vite が mode ごとに読む):
#   .env.development.local  npm run dev のときだけ。Clerk の開発用キー (npx -y clerk@latest env pull --instance dev --file .env.development.local)
#   .env.production.local   npm run build / deploy のとき。Clerk の本番用キー。なければサインインなしのゲスト版になる
#   .env.local              全ての mode。Neon の接続情報 (neon CLI が書く)。画面側には渡らない

# --- Clerk (画面側。公開してよい値) ---
VITE_CLERK_PUBLISHABLE_KEY=
# 本番のビルドを手元で開発用キーのまま試すときだけ 1 にする (npm run preview)
VITE_CLERK_ALLOW_DEV_KEY=

# --- Clerk (サーバー側。画面側のコードで使わない。Worker では cf workers secrets update で入れる) ---
CLERK_SECRET_KEY=

# --- Neon (サーバー側。Worker からは Hyperdrive 経由。docs/deploy.md 段階2) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=
