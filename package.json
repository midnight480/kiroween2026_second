{
  "name": "tomoshibi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "deploy:check": "npm run typecheck && cf deploy --dry-run",
    "deploy": "npm run typecheck && cf deploy",
    "deploy:secrets": "npm run typecheck && cf deploy --secrets-file .env.worker.production",
    "cf:whoami": "cf auth whoami",
    "typecheck": "tsc --noEmit && cf workers types && tsc -p worker",
    "db:migrate": "node scripts/migrate.mjs",
    "secrets:build": "node scripts/worker-secrets.mjs",
    "demo:seed": "node scripts/demo-seed.mjs",
    "video": "node video/tts.mjs && node video/record.mjs && node video/build.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-rc.1",
    "@types/pg": "^8.23.1",
    "cf": "^1.0.0-rc.1",
    "typescript": "^5.6.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@clerk/backend": "^3.30.0",
    "@clerk/clerk-js": "^6.44.0",
    "@clerk/localizations": "^4.25.0",
    "@neon/config": "^1.14.3",
    "@neon/env": "^2.1.6",
    "pg": "^8.23.1"
  }
}
